# Routine commands Codex may run without asking, and the ones that always ask
# because they delete data.

prefix_rule(
    pattern = ["bin/rails", "test"],
    decision = "allow",
    justification = "Running the tests changes nothing",
)

prefix_rule(
    pattern = ["bin/rails", "runner"],
    decision = "allow",
    justification = "Running a Ruby file in this app",
)

prefix_rule(
    pattern = ["bin/rails", "db:migrate"],
    decision = "allow",
    justification = "Applying this repo's migrations",
)

prefix_rule(
    pattern = ["bin/rails", "generate", ["model", "migration"]],
    decision = "allow",
    justification = "Generating a model or migration file",
)

prefix_rule(
    pattern = ["bin/reset-db"],
    decision = "prompt",
    justification = "Deletes every row in the database",
)

prefix_rule(
    pattern = ["bin/rails", ["db:rollback", "db:reset", "db:drop", "db:migrate:reset"]],
    decision = "prompt",
    justification = "Undoes migrations or deletes the database",
)
